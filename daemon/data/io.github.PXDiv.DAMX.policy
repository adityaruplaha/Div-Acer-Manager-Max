<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Div Acer Manager Max</vendor>
  <vendor_url>https://github.com/PXDiv/Div-Acer-Manager-Max</vendor_url>

  <!-- Settings a user at the laptop changes routinely, as with power profiles -->
  <action id="io.github.PXDiv.DAMX.change-settings">
    <description>Change Acer laptop settings</description>
    <message>Authentication is required to change the laptop's fan, keyboard, battery and power settings</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <!-- Reloading the kernel module or changing its options affects the whole system -->
  <action id="io.github.PXDiv.DAMX.manage-driver">
    <description>Manage the Acer laptop driver</description>
    <message>Authentication is required to reload the Acer laptop driver, change its options or restart the DAMX daemon</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
